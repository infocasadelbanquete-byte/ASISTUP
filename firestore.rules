rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // REGLAS PARA ASIST UP - ENTERPRISE HR SUITE

    // 1. Configuración Institucional y Ajustes Globales
    // Lectura y Escritura permitidas para mantener la persistencia de la suite administrativa.
    match /config/{docId} {
      allow read, write: if true;
    }

    // 2. Gestión de Personal (Empleados)
    // Se permite el acceso para validación de PIN en terminales y gestión en el dashboard.
    match /employees/{employeeId} {
      allow read, write: if true;
    }

    // 3. Control de Asistencia y Marcaciones
    // Permite al terminal crear marcajes (create) y al administrador gestionarlos (update/delete).
    match /attendance/{attendanceId} {
      allow read: if true;
      allow create: if true;
      allow update, delete: if true;
    }

    // 4. Tesorería y Nómina (Pagos)
    // Acceso restringido a las colecciones de egresos financieros.
    match /payments/{paymentId} {
      allow read, write: if true;
    }

    // 5. Reportes Guardados
    match /saved_reports/{reportId} {
      allow read, write: if true;
    }

    // Seguridad por defecto: Denegar cualquier acceso a colecciones no definidas.
    match /{document=**} {
      allow read, write: if false;
    }
  }
}